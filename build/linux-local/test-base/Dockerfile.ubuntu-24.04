# test base for KanokOffice .deb: Ubuntu 24.04 + the system libraries the office links to (no KanokOffice)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libatk1.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libdconf1 libfontconfig1 libfreetype6 libgtk-3-0t64 \
    libglib2.0-0t64 libgssapi-krb5-2 libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libice6 libsm6 libnss3 \
    libpython3.12t64 python3 libx11-6 libx11-xcb1 libxext6 libxinerama1 libxrandr2 libxrender1 zlib1g \
    locales xvfb xauth imagemagick poppler-utils \
 && sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
 && rm -rf /var/lib/apt/lists/*
