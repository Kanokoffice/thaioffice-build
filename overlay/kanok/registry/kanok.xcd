<?xml version="1.0" encoding="UTF-8"?>
<!-- KanokOffice (NALLTC Limited) · new file, not part of LibreOffice
     This Source Code Form is subject to the terms of the Mozilla Public
     License, v. 2.0. If a copy of the MPL was not distributed with this
     file, You can obtain one at http://mozilla.org/MPL/2.0/.
     Thai defaults in the installation layer: users can change every value in Tools > Options
     (their choice is stored in the user profile and wins over this file).
     A share/registry .xcd is read before the user interface language is chosen at startup,
     which a bundled extension is not (extensions are synchronised later), so UILocale works
     from the very first start. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
 <dependency file="main"/>
 <!-- writer.xcd and calc.xcd set an empty ooSetupFactoryTemplateFile; parse after them so our template paths win -->
 <dependency file="writer" optional="true"/>
 <dependency file="calc" optional="true"/>
 <oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office">
  <node oor:name="General">
   <prop oor:name="UILocale"><value>th</value></prop>
   <prop oor:name="DefaultLocale"><value>th-TH</value></prop>
   <prop oor:name="DefaultLocale_CTL"><value>th-TH</value></prop>
  </node>
 </oor:component-data>
 <oor:component-data oor:name="Setup" oor:package="org.openoffice">
  <node oor:name="L10N">
   <prop oor:name="ooSetupSystemLocale"><value>th-TH</value></prop>
  </node>
  <node oor:name="Product">
   <prop oor:name="ooSetupLastVersion"><value>26.8</value></prop>
   <prop oor:name="WhatsNew"><value>false</value></prop>
   <prop oor:name="WhatsNewDialog"><value>false</value></prop>
   <!-- no LibreOffice get-involved / donate infobars: "last shown" = 1 Jan 2100 -->
   <prop oor:name="LastTimeGetInvolvedShown"><value>4102444800</value></prop>
   <prop oor:name="LastTimeDonateShown"><value>4102444800</value></prop>
  </node>
  <node oor:name="Office">
   <node oor:name="Factories">
    <node oor:name="com.sun.star.text.TextDocument">
     <prop oor:name="ooSetupFactoryTemplateFile"><value>$(inst)/share/kanok/thai-default.ott</value></prop>
    </node>
    <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
     <prop oor:name="ooSetupFactoryTemplateFile"><value>$(inst)/share/kanok/thai-default-calc.ots</value></prop>
    </node>
   </node>
  </node>
 </oor:component-data>
 <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
   <prop oor:name="ShowTipOfTheDay"><value>false</value></prop>
   <prop oor:name="FirstRun"><value>false</value></prop>
   <prop oor:name="ShowDonation"><value>false</value></prop>
  </node>
  <node oor:name="I18N">
   <node oor:name="CTL">
    <prop oor:name="CTLFont"><value>true</value></prop>
   </node>
  </node>
  <!-- links: kanokoffice.com instead of hub.libreoffice.org -->
  <node oor:name="Menus">
   <prop oor:name="SendFeedbackURL"><value>https://kanokoffice.com/feedback/</value></prop>
   <prop oor:name="QA_URL"><value>https://kanokoffice.com/forum/</value></prop>
   <prop oor:name="DocumentationURL"><value>https://kanokoffice.com/docs/</value></prop>
   <prop oor:name="GetInvolvedURL"><value>https://kanokoffice.com/joinus/</value></prop>
   <prop oor:name="DonationURL"><value>https://kanokoffice.com/support/</value></prop>
   <prop oor:name="ReleaseNotesURL"><value>https://kanokoffice.com/release-notes/</value></prop>
   <prop oor:name="CreditsURL"><value>https://kanokoffice.com/credits/</value></prop>
   <prop oor:name="HyphenationMissingURL"><value>https://kanokoffice.com/hyphenation/</value></prop>
   <prop oor:name="InstallJavaURL"><value>https://kanokoffice.com/java/</value></prop>
   <prop oor:name="VolunteerURL"><value>https://kanokoffice.com/volunteer/</value></prop>
   <prop oor:name="ExtensionsURL"><value>https://kanokoffice.com/extensions/</value></prop>
  </node>
  <node oor:name="Help">
   <prop oor:name="HelpRootURL"><value>https://kanokoffice.com/help/?</value></prop>
  </node>
 </oor:component-data>
</oor:data>
